<resources>

    <!--
        Base application theme, dependent on API level. This theme is replaced
        by AppBaseTheme from res/values-vXX/styles.xml on newer devices.
    -->
    <style name="AppBaseTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.
        -->
    </style>

    <!-- Application theme. -->
    <style name="AppTheme" parent="AppBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="actionBarTabTextStyle">@style/AppActionBarTabText</item>
        <item name="actionOverflowMenuStyle">@style/AppOverflowMenu</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
    </style>

    <style name="AppOverflowMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:dropDownListViewStyle">@style/AppDropDownListView</item>
    </style>

    <style name="AppPopupMenu" parent="Widget.AppCompat.PopupMenu">
        <item name="android:dropDownListViewStyle">@style/AppDropDownListView</item>
    </style>

    <style name="AppDropDownListView" parent="Widget.AppCompat.ListView.DropDown">
    </style>

    <!-- Tab titles as Title Case instead of the default ALL CAPS. -->
    <style name="AppActionBarTabText" parent="Widget.AppCompat.ActionBar.TabText">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>


    <style name="AppBaseTheme2" parent="Theme.AppCompat"/>
    <style name="AppTheme2" parent="AppBaseTheme2">
        <item name="actionOverflowMenuStyle">@style/AppOverflowMenu</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
    </style>

    <!--  there is no such thing as a theme.light.dialog -->
    <style name="AppDialogTheme" parent="@android:style/Theme.Dialog"/>
    <!-- dark dialog hmm -->
    <style name="AppDialogTheme2" parent="@android:style/Theme.Dialog"/>


    <style name="WidgetText">
        <item name="android:textColor">#ffffffff</item>
        <item name="android:textSize">12sp</item>
        <item name="android:shadowColor">#000000</item>
        <item name="android:shadowDx">1</item>
        <item name="android:shadowDy">1</item>
        <item name="android:shadowRadius">1</item>
    </style>

    <style name="AccentDialogTheme" parent="Theme.AppCompat.Light.Dialog">
        <item name="colorAccent">@color/holo_green_dark</item>
    </style>

    <!-- Material 3 themes for the 3 activities hosting MaterialDatePicker (DaysDiffActivity,
         EditEventActivity, EditHistory) - applied via setTheme() at runtime alongside the
         existing light/dark preference toggle, same pattern as AppDialogTheme/AppDialogTheme2
         but scoped separately so the other activities sharing those two styles are
         unaffected. See DCR_evolveToMaterialDatePicker.md §4/§8. -->
    <style name="DatePickerHostThemeLight" parent="Theme.Material3.Light">
        <item name="colorPrimary">@color/holo_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/picker_primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/picker_on_primary_container_light</item>
        <item name="miniBButtonFillColor">@color/mini_b_button_fill_light</item>
        <item name="materialCalendarTheme">@style/DatePickerCalendarThemeOverlay</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="DatePickerHostThemeDark" parent="Theme.Material3.Dark">
        <item name="colorPrimary">@color/holo_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/picker_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/picker_on_primary_container_dark</item>
        <item name="miniBButtonFillColor">@color/mini_b_button_fill_dark</item>
        <item name="materialCalendarTheme">@style/DatePickerCalendarThemeOverlay</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="DatePickerCalendarThemeOverlay" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="buttonBarPositiveButtonStyle">@style/DatePickerActionButtonLight</item>
        <item name="buttonBarNegativeButtonStyle">@style/DatePickerActionButtonLight</item>
    </style>

    <style name="DatePickerDialogThemeLight" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="buttonBarPositiveButtonStyle">@style/DatePickerActionButtonLight</item>
        <item name="buttonBarNegativeButtonStyle">@style/DatePickerActionButtonLight</item>
    </style>

    <style name="DatePickerDialogThemeDark" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="buttonBarPositiveButtonStyle">@style/DatePickerActionButtonDark</item>
        <item name="buttonBarNegativeButtonStyle">@style/DatePickerActionButtonDark</item>
    </style>

    <style name="DatePickerActionButtonLight" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/holo_green_dark</item>
        <item name="backgroundTint">@color/mini_b_button_fill_light</item>
        <item name="cornerRadius">3dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="DatePickerActionButtonDark" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:textColor">@color/holo_green_dark</item>
        <item name="backgroundTint">@color/mini_b_button_fill_dark</item>
        <item name="cornerRadius">3dp</item>
        <item name="android:minWidth">72dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="SettingsThemeLight" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="actionOverflowMenuStyle">@style/AppOverflowMenu</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
    </style>

    <style name="SettingsThemeDark" parent="Theme.AppCompat.NoActionBar">
        <item name="actionOverflowMenuStyle">@style/AppOverflowMenu</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
    </style>

    <style name="MiniAThemeLight" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="actionOverflowMenuStyle">@style/AppOverflowMenu</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="miniBButtonFillColor">@color/mini_b_button_fill_light</item>
    </style>

    <style name="MiniAThemeDark" parent="Theme.AppCompat.NoActionBar">
        <item name="actionOverflowMenuStyle">@style/AppOverflowMenu</item>
        <item name="popupMenuStyle">@style/AppPopupMenu</item>
        <item name="miniBButtonFillColor">@color/mini_b_button_fill_dark</item>
    </style>

    <style name="MiniAEventThemeLight" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/holo_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/picker_primary_container_light</item>
        <item name="colorOnPrimaryContainer">@color/picker_on_primary_container_light</item>
        <item name="miniBButtonFillColor">@color/mini_b_button_fill_light</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="MiniAEventThemeDark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/holo_green_dark</item>
        <item name="colorOnPrimary">@android:color/white</item>
        <item name="colorPrimaryContainer">@color/picker_primary_container_dark</item>
        <item name="colorOnPrimaryContainer">@color/picker_on_primary_container_dark</item>
        <item name="miniBButtonFillColor">@color/mini_b_button_fill_dark</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>

    <style name="MiniBActionButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/mini_b_button_fill</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/holo_green_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
    </style>

    <style name="MiniBOutlinedActionButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/mini_b_button_outline</item>
        <item name="android:backgroundTint">@null</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">@color/holo_green_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="textAllCaps">false</item>
        <item name="android:minHeight">40dp</item>
    </style>

    <style name="MiniBButtonRow">
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
        <item name="android:paddingTop">8dp</item>
    </style>

    <style name="MiniBSectionLabel">
        <item name="android:textColor">@color/holo_green_dark</item>
    </style>

</resources>