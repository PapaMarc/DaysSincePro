<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/mini_a_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.ActionBar"
        app:titleCentered="true" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent" >

    <ImageButton
        android:id="@+id/addButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentLeft="true"
        android:layout_alignParentTop="true"
        android:layout_marginStart="8dp"
        android:layout_marginTop="4dp"
        android:background="@android:color/transparent"
        android:padding="8dp"
        android:src="@drawable/ic_action_add"
        android:contentDescription="@string/add_category_tooltip" />

    <Button
        android:id="@+id/all_clearButton"
        style="@style/MiniBActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentRight="true"
        android:layout_alignParentTop="true"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:minWidth="72dp"
        android:singleLine="true"
        android:text="@string/clear"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <ListView
        android:id="@android:id/list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/addButton"
        android:layout_above="@+id/linearLayout1">
    </ListView>

    <TextView
        android:id="@android:id/empty"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_above="@+id/linearLayout1"
        android:layout_below="@+id/addButton"
        android:text="@string/no_entries1"
        android:paddingLeft="8dip"
        android:textColor="#00DDFF"
        android:textSize="25sp" />

    <LinearLayout
        android:id="@+id/linearLayout1"
        style="@style/MiniBButtonRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true" >

        <Button
            android:id="@+id/buttonOK"
            style="@style/MiniBActionButton"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_marginRight="8dp"
            android:layout_weight="1"
            android:text="@string/mini_b_ok" />

        <Button
            android:id="@+id/doneButton"
            style="@style/MiniBActionButton"
            android:layout_width="0dip"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/Cancel" />
    </LinearLayout>

    </RelativeLayout>

</LinearLayout>